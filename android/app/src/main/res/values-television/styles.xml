<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- TVs: the branded launch frame stays behind the Flutter view until its first frame.
         Android TV shows no starting window, so NormalTheme carries it there too. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/anim_splash</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
