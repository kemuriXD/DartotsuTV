<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- TVs: a static logo with the empty loading bar stays up until Flutter's first frame (SplashApp
         draws the same logo and starts the bar). Android TV shows no starting window, so NormalTheme
         carries it too, and the system splash on warm starts shows the same static logo. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
